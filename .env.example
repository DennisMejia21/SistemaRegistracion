# Copia este archivo a `.env` y cambia los valores. El `.env` NO se sube al
# repositorio (esta en el .gitignore): es el unico lugar donde viven las
# contrasenas y el token de este servicio.
#
#   cp .env.example .env
#   docker compose up --build
#
# docker compose lee el `.env` de esta carpeta solo. Sin el, `up` no arranca:
# las variables sin valor por defecto cortan el arranque a proposito, para que
# nadie termine levantando el padron con la contrasena de ejemplo.

# --- Base de datos ------------------------------------------------------
# Usuario y base que crea mysql la primera vez que se levanta el volumen.
DB_NAME=registracion
DB_USER=registracion_user

# Contrasena de DB_USER. La usan mysql y el servicio: es la misma de los dos
# lados. Cambiala.
DB_PASSWORD=cambiame

# Contrasena de root de mysql, para entrar por phpMyAdmin o hacer un dump.
MYSQL_ROOT_PASSWORD=cambiame-tambien

# --- Servicio -----------------------------------------------------------
# Token del LOGIN CENTRAL, la unica aplicacion que ve el padron entero. Va en
# `Authorization: Bearer <token>` y es el que se pone en PADRON_TOKEN del front
# de login.
#
# Los fronts de los proyectos NO usan este: cada uno tiene el suyo, que se crea
# con POST /aplicaciones y solo ve a la gente de ese proyecto. Este valor se
# sincroniza con la tabla `aplicaciones` cada vez que arranca el servicio.
#
# Uno nuevo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=token-de-desarrollo

# Token de la catedra: emitir resets de contrasena (POST /password/reset) y dar
# de alta las aplicaciones de cada proyecto (POST /aplicaciones).
#
# TIENE que ser distinto de API_TOKEN, y no se le pasa a ningun front: con este
# se le puede cambiar la contrasena a cualquiera. Si son iguales, el servicio se
# niega a emitir resets.
ADMIN_TOKEN=admin-de-desarrollo

# Cuantos minutos vive un token de reset. Corto a proposito: viaja por fuera del
# sistema (se lo pasan a la persona por donde puedan).
MINUTOS_DE_RESET=30

# Cuantos segundos vive un codigo de ingreso a un proyecto (POST /codigos).
# Solo tiene que sobrevivir el redirect del login a la plataforma del proyecto.
SEGUNDOS_DE_CODIGO=60

# --- Puertos ------------------------------------------------------------
# Los de la maquina, no los de adentro de los contenedores. Cambialos si
# alguno ya esta ocupado; el codigo no se entera.
PUERTO_API=8000
PUERTO_MYSQL=3307
PUERTO_PHPMYADMIN=8081

# Interfaz donde se publican esos puertos. 127.0.0.1 = solo esta maquina, que
# es lo que se quiere mientras se desarrolla. Ponelo en 0.0.0.0 solo si
# necesitas que otra maquina de la red le pegue al padron.
BIND_HOST=127.0.0.1
